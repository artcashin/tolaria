# Copy to .env.local and fill in real values. .env.local is gitignored, so it
# survives updates pulled from upstream; this file is the tracked template.
#
# Expo loads .env.local from this directory automatically and inlines every
# EXPO_PUBLIC_* value into the JS bundle AT BUILD TIME — changing one means
# rebuilding (pnpm mobile:ios:device), not just relaunching.

# Where the workspace comes from:
#   fixture      bundled sample content (the default when unset)
#   dev-vault    HTTP bridge on your machine — see below
#   native-vault a folder on the device itself
#   host-vault   the embedding host
EXPO_PUBLIC_TOLARIA_WORKSPACE_SOURCE=

# Base URL of the dev vault bridge, no trailing slash; the app appends
# /snapshot. On a real device this cannot be localhost — it has to be an
# address the device can reach.
#
# Over Tailscale, prefer the MagicDNS name over the 100.x address: it survives
# a node re-registration and resolves on any device signed into the tailnet.
#   http://<machine>.<tailnet>.ts.net:8765
#
# The bridge is READ-ONLY (GET /snapshot, GET /health) and returns the whole
# vault in one uncompressed response, so it is a viewer, not a sync engine.
EXPO_PUBLIC_TOLARIA_DEV_VAULT_URL=

# Absolute path to the vault the bridge should serve. Read by
# `pnpm mobile:dev-vault`, not by the app. Required: the compiled-in default
# points at an upstream developer's own machine.
MOBILE_DEV_VAULT_PATH=

# Port for the bridge (default 8765).
MOBILE_DEV_VAULT_PORT=

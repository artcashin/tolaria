# Copy to .env.local and fill in real values.
# These are never committed — .env.local is gitignored.
# Release workflows must mirror these values into GitHub Actions secrets:
# - VITE_SENTRY_DSN
# - SENTRY_DSN (same value as VITE_SENTRY_DSN for Rust-side crash reporting)
# - VITE_POSTHOG_KEY
# - VITE_POSTHOG_HOST

# Sentry DSN (https://sentry.io → Project → Settings → Client Keys)
VITE_SENTRY_DSN=

# PostHog (https://posthog.com → Project → Settings → Project API Key)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Lara CLI (https://github.com/translated/lara-cli)
LARA_ACCESS_KEY_ID=
LARA_ACCESS_KEY_SECRET=

# ---------------------------------------------------------------------------
# iPadOS signing (apps/mobile)
# ---------------------------------------------------------------------------
# Apple team id, needed only to run on a PHYSICAL iPad — the simulator runs
# unsigned. It identifies your developer account, and apps/mobile/ios is
# generated rather than committed, so it lives here.
#
#   1. Xcode > Settings > Accounts > + > Apple ID.  A free Apple ID is enough:
#      it creates a "Personal Team" that can sign for your own devices.
#   2. pnpm mobile:ios:team      # prints the id
#   3. paste it below
APPLE_DEVELOPMENT_TEAM=
